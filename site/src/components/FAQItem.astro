---
interface Props {
  question: string;
  defaultOpen?: boolean;
}
const { question, defaultOpen = false } = Astro.props;
---
<div class="faq-item">
  <button class="faq-trigger" aria-expanded={defaultOpen ? 'true' : 'false'}>
    <span>{question}</span>
    <span class="faq-icon">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" />
      </svg>
    </span>
  </button>
  <div class="faq-panel">
    <p><slot /></p>
  </div>
</div>
