---
interface Props {
  eyebrow?: string;
  title?: string;
  subtitle?: string;
  author?: string;
  label?: string;
  tilt?: boolean;
}
const {
  eyebrow = 'Guia Clínico',
  title = 'Complicações na HOF',
  subtitle = 'Condutas seguras, protocolos atualizados e fluxogramas de conduta rápida.',
  author = 'Dr. Maurício Araújo',
  label = 'Harmonização Orofacial',
  tilt = true,
} = Astro.props;
const transform = tilt ? 'rotateY(-14deg) rotateX(3deg)' : 'none';
---
<div style="perspective:1700px;">
  <div class="ebook-panel" style={`position:relative;width:100%;aspect-ratio:3 / 4;transform:${transform};transform-style:preserve-3d;border-radius:3px 12px 12px 3px;background:var(--gradient-cover);box-shadow:var(--shadow-lg);overflow:hidden;`}>
    <span style="position:absolute;top:3%;bottom:3%;right:0;width:8px;background:repeating-linear-gradient(90deg, #e9e3d4, #e9e3d4 1px, #cfc7b3 1px, #cfc7b3 2px);opacity:0.5;" />
    <span style="position:absolute;top:0;bottom:0;left:0;width:16px;background:linear-gradient(90deg, rgba(0,0,0,0.40), rgba(255,255,255,0.10) 70%, rgba(0,0,0,0.10));" />
    <span style="position:absolute;inset:0;background:radial-gradient(120% 60% at 28% 0%, rgba(194,160,82,0.18), transparent 55%);pointer-events:none;" />
    <span style="position:absolute;inset:16px 16px 16px 24px;border:1px solid var(--hairline-gold);border-radius:2px;pointer-events:none;" />

    <div style="position:relative;height:100%;display:flex;flex-direction:column;padding:clamp(24px, 8%, 44px) clamp(22px, 7%, 40px) clamp(22px, 7%, 40px) clamp(30px, 9%, 50px);color:var(--text-on-dark);">
      <span style="font-family:var(--font-text);font-size:11px;font-weight:600;letter-spacing:0.24em;text-transform:uppercase;color:var(--accent-on-dark);">{eyebrow}</span>

      <div style="margin-top:auto;">
        <h3 style="font-family:var(--font-display);font-weight:600;font-size:clamp(1.7rem, 1rem + 3.4vw, 2.8rem);line-height:1.04;letter-spacing:-0.01em;margin:0;color:var(--text-on-dark);">{title}</h3>
        <span style="display:block;width:48px;height:2px;background:var(--gold-500);margin:18px 0;" />
        <p style="font-family:var(--font-text);font-size:13px;line-height:1.5;color:var(--text-on-dark-muted);margin:0;max-width:30ch;">{subtitle}</p>
      </div>

      <div style="margin-top:26px;padding-top:16px;border-top:1px solid var(--hairline-on-dark);">
        <div style="font-family:var(--font-display);font-size:18px;font-weight:600;color:var(--text-on-dark);">{author}</div>
        <div style="font-family:var(--font-text);font-size:10.5px;letter-spacing:0.18em;text-transform:uppercase;color:var(--accent-on-dark);margin-top:3px;">{label}</div>
      </div>
    </div>
  </div>
</div>
