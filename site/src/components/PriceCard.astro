---
import Button from './Button.astro';
interface Props {
  badge?: string;
  anchorPrice?: string;
  installments?: string;
  cashPrice?: string;
  note?: string;
  ctaLabel?: string;
  ctaHref?: string;
}
const {
  badge = 'Acesso imediato',
  anchorPrice = 'R$ 97,00',
  installments = '3x de R$ 24,94',
  cashPrice = 'R$ 69,90 à vista',
  note = 'Acesso imediato via Hotmart · 1 ano de acesso',
  ctaLabel = 'Quero meu e-book agora',
  ctaHref = 'https://pay.hotmart.com/G99756037V',
} = Astro.props;
---
<div style="position:relative;background:var(--gradient-cover);border-radius:var(--radius-xl);border:1px solid var(--hairline-gold);box-shadow:var(--shadow-lg);padding:var(--space-8) var(--space-7);text-align:center;color:var(--text-on-dark);overflow:hidden;">
  <span style="position:absolute;inset-inline:0;top:0;height:3px;background:linear-gradient(90deg, transparent, var(--gold-500), transparent);" />

  <span style="display:inline-block;font-family:var(--font-text);font-size:12px;font-weight:600;letter-spacing:0.18em;text-transform:uppercase;color:var(--accent-on-dark);border:1px solid var(--hairline-gold);border-radius:var(--radius-pill);padding:7px 16px;">
    {badge}
  </span>

  <div style="margin-top:var(--space-6);font-family:var(--font-text);font-size:15px;color:var(--text-on-dark-muted);">
    De <span style="text-decoration:line-through;">{anchorPrice}</span> por
  </div>

  <div style="font-family:var(--font-display);font-weight:600;font-size:clamp(2.4rem, 1.6rem + 3vw, 3.4rem);line-height:1.05;letter-spacing:-0.02em;color:var(--text-on-dark);margin-top:4px;">
    {installments}
  </div>
  <div style="margin-top:6px;font-family:var(--font-text);font-size:16px;color:var(--accent-on-dark);">
    ou {cashPrice}
  </div>

  <div style="margin:var(--space-6) 0 var(--space-5);">
    <Button variant="primary" size="lg" fullWidth href={ctaHref}>{ctaLabel}</Button>
  </div>

  <p style="margin:0;font-family:var(--font-text);font-size:13px;color:var(--text-on-dark-muted);">{note}</p>
</div>
