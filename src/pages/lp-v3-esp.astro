  .v3-compare-good { border-color: var(--hairline-gold); background: var(--gold-100); }
  .v3-compare-good li { color: var(--text-body); }
  .v3-compare-good img { width: 100%; max-width: 320px; height: auto; display: block; margin: 18px auto 0; border-radius: var(--radius-md); border: 1px solid var(--hairline-gold); }

